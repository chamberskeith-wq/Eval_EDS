#:kivy 2.3.0
#:import dp kivy.metrics.dp

# ============================================================
# EvalEDS main application layout
# Individual screen layouts are loaded by their Python modules.
# ============================================================

<EvalEDSScreen>:
    orientation: "vertical"
    spacing: dp(3)
    padding: dp(8)

    ScreenManager:
        id: screen_manager
        size_hint_y: 1

        InspectorScreen:
            name: "inspector"

        StatusScreen:
            name: "status"

        ConfigurationScreen:
            name: "configuration"

    # Navigation bar
    BoxLayout:
        id: navigation_bar
        orientation: "horizontal"
        size_hint_y: None
        height: dp(48)
        spacing: dp(5)

        Button:
            text: "Inspector"
            on_release: screen_manager.current = "inspector"

        Button:
            text: "Connections"
            on_release: screen_manager.current = "status"

        Button:
            text: "Settings"
            on_release: screen_manager.current = "configuration"

    # Application status strip
    BoxLayout:
        size_hint_y: None
        height: dp(30)
        padding: dp(8), 0

        canvas.before:
            Color:
                rgba: 0.18, 0.22, 0.28, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            id: application_status
            text: "Eval_EDS"
            color: 1, 1, 1, 1
            halign: "left"
            valign: "middle"
            text_size: self.size
