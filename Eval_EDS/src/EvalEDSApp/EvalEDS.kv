
#:kivy 2.3.0
#:import dp kivy.metrics.dp

# ============================================================
# EvalEDS main application layout
# Individual screen layouts are loaded by their Python modules.
# ============================================================

<EvalEDSScreen>:
    orientation: "vertical"
    spacing: dp(3)
    padding: dp(8)

    ScreenManager:
        id: screen_manager
        size_hint_y: 1

        StreamInspectorScreen:
            name: "stream_inspector"

        StreamConfigurationScreen:
            name: "stream_configuration"

        EDSAdministrationScreen:
            name: "eds_administration"

        LoggingScreen:
            name: "logging"

        SettingsScreen:
            name: "settings"
            
    # Navigation bar
    BoxLayout:
        id: navigation_bar
        orientation: "horizontal"
        size_hint_y: None
        height: dp(48)
        spacing: dp(5)

        Button:
            text: "Stream Inspector"
            on_release: screen_manager.current = "stream_inspector"

        Button:
            text: "Stream Configuration"
            on_release: screen_manager.current = "stream_configuration"

        Button:
            text: "EDS Administration"
            on_release: screen_manager.current = "eds_administration"

        Button:
            text: "Logging"
            on_release: screen_manager.current = "logging"

        Button:
            text: "⚙"
            font_name: "DejaVuSans"
            font_size: dp(22)
            size_hint_x: None
            width: dp(55)
            on_release: screen_manager.current = "settings"

    # Application status strip
    BoxLayout:
        size_hint_y: None
        height: dp(30)
        padding: dp(8), 0

        canvas.before:
            Color:
                rgba: 0.18, 0.22, 0.28, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            id: application_status
            text: "Eval_EDS"
            color: 1, 1, 1, 1
            halign: "left"
            valign: "middle"
            text_size: self.size
