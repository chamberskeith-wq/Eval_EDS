
#:kivy 2.3.0
#:import dp kivy.metrics.dp

# ============================================================
# EvalEDS - Main UI
# ============================================================

<PanelHeader@BoxLayout>:
    title: ""
    size_hint_y: None
    height: "42dp"
    padding: "10dp", 0

    canvas.before:
        Color:
            rgba: 0.18, 0.22, 0.28, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: root.title
        bold: True
        halign: "left"
        valign: "middle"
        text_size: self.size
        color: 1, 1, 1, 1


<EvalEDSScreen>:

    BoxLayout:
        orientation: "vertical"
        padding: "8dp"
        spacing: "8dp"

        # ====================================================
        # Main three-panel workspace
        # ====================================================

        BoxLayout:
            orientation: "horizontal"
            spacing: "8dp"

            # =================================================
            # INSPECTOR PANEL
            # =================================================

            BoxLayout:
                id: inspector_panel
                orientation: "vertical"
                size_hint_x: 0.30
                spacing: "5dp"

                canvas.before:
                    Color:
                        rgba: 0.94, 0.95, 0.97, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                PanelHeader:
                    title: "Inspector"

                Label:
                    text: "Browse and select an item to inspect"
                    size_hint_y: None
                    height: "34dp"
                    color: 0.25, 0.28, 0.32, 1
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    padding: "8dp", 0

                ScrollView:
                    id: inspector_scroll
                    do_scroll_x: False
                    bar_width: "8dp"

                    GridLayout:
                        id: inspector_content
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: "4dp"
                        padding: "8dp"

                        Label:
                            text: "Inspector content will be populated by the application."
                            size_hint_y: None
                            height: self.texture_size[1] + dp(16)
                            text_size: self.width, None
                            halign: "left"
                            valign: "top"
                            color: 0.25, 0.28, 0.32, 1


            # =================================================
            # STATUS PANEL
            # =================================================

            BoxLayout:
                id: status_panel
                orientation: "vertical"
                size_hint_x: 0.30
                spacing: "5dp"

                canvas.before:
                    Color:
                        rgba: 0.97, 0.97, 0.97, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                PanelHeader:
                    title: "Status"

                BoxLayout:
                    size_hint_y: None
                    height: "34dp"
                    padding: "8dp", 0

                    Label:
                        text: "Application activity and messages"
                        color: 0.25, 0.28, 0.32, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                ScrollView:
                    id: status_scroll
                    do_scroll_x: False
                    bar_width: "8dp"

                    TextInput:
                        id: status_output
                        text: "Ready. Status messages will appear here."
                        readonly: True
                        multiline: True
                        size_hint_y: None
                        height: max(self.minimum_height, status_scroll.height)
                        padding: "8dp"
                        background_color: 0.99, 0.99, 0.99, 1
                        foreground_color: 0.18, 0.20, 0.23, 1
                        cursor_blink: False


            # =================================================
            # CONFIGURATION PANEL
            # =================================================

            BoxLayout:
                id: configuration_panel
                orientation: "vertical"
                size_hint_x: 0.40
                spacing: "5dp"

                canvas.before:
                    Color:
                        rgba: 0.94, 0.95, 0.97, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                PanelHeader:
                    title: "Configuration"

                Label:
                    text: "Application configuration"
                    size_hint_y: None
                    height: "34dp"
                    color: 0.25, 0.28, 0.32, 1
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                    padding: "8dp", 0

                ScrollView:
                    id: configuration_scroll
                    do_scroll_x: False
                    bar_width: "8dp"

                    BoxLayout:
                        id: configuration_content
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: "10dp"
                        padding: "8dp"

                        # -------------------------------------
                        # Configuration file and profile
                        # -------------------------------------

                        GridLayout:
                            id: configuration_fields
                            cols: 2
                            size_hint_y: None
                            height: self.minimum_height
                            row_default_height: "42dp"
                            row_force_default: True
                            spacing: "6dp"

                            Label:
                                text: "Configuration file"
                                halign: "right"
                                valign: "middle"
                                text_size: self.size
                                color: 0.20, 0.22, 0.25, 1

                            BoxLayout:
                                spacing: "4dp"

                                TextInput:
                                    id: configuration_file
                                    hint_text: "Select or enter a file path"
                                    multiline: False

                                Button:
                                    id: browse_configuration
                                    text: "Browse"
                                    size_hint_x: None
                                    width: "82dp"
                                    on_release: root.set_status("File browsing will be added with configuration editing.")

                            Label:
                                text: "Configuration profile"
                                halign: "right"
                                valign: "middle"
                                text_size: self.size
                                color: 0.20, 0.22, 0.25, 1

                            Spinner:
                                id: configuration_profile
                                text: "Default"
                                values: ["Default"]

                        # -------------------------------------
                        # Configuration properties
                        # -------------------------------------

                        Label:
                            text: "Configuration properties will be generated from the application's configuration schema."
                            size_hint_y: None
                            height: self.texture_size[1] + dp(12)
                            text_size: self.width, None
                            halign: "left"
                            valign: "top"
                            color: 0.35, 0.37, 0.40, 1

                        GridLayout:
                            id: configuration_property_fields
                            cols: 2
                            size_hint_y: None
                            height: self.minimum_height
                            row_default_height: "42dp"
                            row_force_default: True
                            spacing: "6dp"

                # ---------------------------------------------
                # Configuration actions
                # ---------------------------------------------

                BoxLayout:
                    size_hint_y: None
                    height: "46dp"
                    spacing: "6dp"
                    padding: "6dp"

                    Button:
                        id: load_configuration
                        text: "Load"
                        on_release: root.on_load_configuration()

                    Button:
                        id: validate_configuration
                        text: "Verify"
                        on_release: root.on_verify_configuration()

                    Button:
                        id: save_configuration
                        text: "Save"
                        on_release: root.on_save_configuration()


        # ====================================================
        # APPLICATION STATUS STRIP
        # ====================================================

        BoxLayout:
            size_hint_y: None
            height: "30dp"
            padding: "8dp", 0

            canvas.before:
                Color:
                    rgba: 0.18, 0.22, 0.28, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                id: application_status
                text: "Eval_EDS"
                color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.size
