#:kivy 2.3.0
#:import dp kivy.metrics.dp

<InspectorScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(8)
        spacing: dp(5)

        canvas.before:
            Color:
                rgba: 0.94, 0.95, 0.97, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # Screen header
        BoxLayout:
            size_hint_y: None
            height: dp(42)
            padding: dp(10), 0

            canvas.before:
                Color:
                    rgba: 0.18, 0.22, 0.28, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "Inspector"
                bold: True
                halign: "left"
                valign: "middle"
                text_size: self.size
                color: 1, 1, 1, 1

        Label:
            text: "Browse and select an item to inspect"
            size_hint_y: None
            height: dp(34)
            color: 0.25, 0.28, 0.32, 1
            halign: "left"
            valign: "middle"
            text_size: self.size
            padding: dp(8), 0

        ScrollView:
            id: inspector_scroll
            do_scroll_x: False
            bar_width: dp(8)

            GridLayout:
                id: inspector_content
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(4)
                padding: dp(8)

                Label:
                    text: "Inspector content will be populated by the application."
                    size_hint_y: None
                    height: self.texture_size[1] + dp(16)
                    text_size: self.width, None
                    halign: "left"
                    valign: "top"
                    color: 0.25, 0.28, 0.32, 1
