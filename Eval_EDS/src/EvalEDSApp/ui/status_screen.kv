
#:kivy 2.3.0
#:import dp kivy.metrics.dp

<StatusScreen>:

    BoxLayout:
        orientation: "vertical"
        padding: dp(8)
        spacing: dp(5)

        canvas.before:
            Color:
                rgba: 0.97, 0.97, 0.97, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # Screen header
        BoxLayout:
            size_hint_y: None
            height: dp(42)
            padding: dp(10), 0

            canvas.before:
                Color:
                    rgba: 0.18, 0.22, 0.28, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "Status"
                bold: True
                halign: "left"
                valign: "middle"
                text_size: self.size
                color: 1, 1, 1, 1

        # Screen description
        BoxLayout:
            size_hint_y: None
            height: dp(34)
            padding: dp(8), 0

            Label:
                text: "Application activity and messages"
                color: 0.25, 0.28, 0.32, 1
                halign: "left"
                valign: "middle"
                text_size: self.size

        # Status output
        ScrollView:
            id: status_scroll
            do_scroll_x: False
            bar_width: dp(8)

            TextInput:
                id: status_output
                text: "Ready. Status messages will appear here."
                readonly: True
                multiline: True
                size_hint_y: None
                height: max(self.minimum_height, status_scroll.height)
                padding: dp(8)
                background_color: 0.99, 0.99, 0.99, 1
                foreground_color: 0.18, 0.20, 0.23, 1
                cursor_blink: False
